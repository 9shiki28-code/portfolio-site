---
import { Image } from 'astro:assets';
import type { Post } from '../lib/content';
import { formatDate, isoDate, readingMinutes } from '../lib/content';

interface Props {
  posts: Post[];
  showImage?: boolean;
}

const { posts, showImage = true } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`} class="item">
          {showImage && (
            <div class="thumb">
              {post.data.cover ? (
                <Image src={post.data.cover} alt={post.data.coverAlt ?? ''} widths={[360, 720]} sizes="(max-width: 640px) 100vw, 240px" />
              ) : (
                <div class="ph"><span>Journal</span></div>
              )}
            </div>
          )}
          <div class="body">
            <p class="meta">
              <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
              <span>約{readingMinutes(post.body)}分</span>
              {post.data.draft && <span class="draft">下書き</span>}
            </p>
            <h3 class="title">{post.data.title}</h3>
            <p class="desc">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <p class="tagline">{post.data.tags.map((t) => `#${t}`).join('　')}</p>
            )}
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  li {
    border-bottom: 1px solid var(--line);
  }

  .item {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: 1.8rem;
    text-decoration: none;
    align-items: start;
  }

  .item:not(:has(.thumb)) {
    grid-template-columns: 1fr;
  }

  .thumb :global(img),
  .thumb .ph {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }

  .meta {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
    margin: 0;
    flex-wrap: wrap;
  }

  .draft {
    color: var(--accent);
  }

  .title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.22rem;
    line-height: 1.6;
    margin: 0.3rem 0 0.5rem;
    transition: color 0.2s;
  }

  .item:hover .title {
    color: var(--accent);
  }

  .desc {
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.8;
    margin: 0;
  }

  .tagline {
    margin: 0.6rem 0 0;
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  @media (max-width: 640px) {
    .item {
      grid-template-columns: 1fr;
    }
  }
</style>
