---
import { AUTHOR, NAV } from '../consts.js';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="brand" aria-label="トップページへ">
      <span class="brand-name">{AUTHOR.name}</span>
      <span class="brand-role">{AUTHOR.role}</span>
    </a>
    <nav aria-label="メインメニュー">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="en">{item.label}</span>
                <span class="ja">{item.ja}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 68px;
    flex-wrap: wrap;
    padding-block: 10px;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    text-decoration: none;
    flex-wrap: wrap;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .brand-role {
    font-size: 0.75rem;
    color: var(--ink-faint);
    letter-spacing: 0.1em;
  }

  ul {
    display: flex;
    gap: clamp(0.9rem, 2.5vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    line-height: 1.3;
  }

  .en {
    font-family: var(--font-en);
    font-size: 1.02rem;
    letter-spacing: 0.08em;
  }

  .ja {
    font-size: 0.62rem;
    color: var(--ink-faint);
    letter-spacing: 0.08em;
  }

  nav a[aria-current='page'] .en {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .brand-role {
      display: none;
    }
    .ja {
      display: none;
    }
  }
</style>
