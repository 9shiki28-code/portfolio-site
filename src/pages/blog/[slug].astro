---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR } from '../../consts.js';
import { getPosts, formatDate, isoDate, readingMinutes, tagHref } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const toc = headings.filter((h) => h.depth === 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { '@type': 'Person', name: AUTHOR.name },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout
  title={d.title}
  description={d.description}
  image={d.cover?.src}
  type="article"
  publishedTime={d.pubDate}
  noindex={d.draft}
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <article class="container container--narrow">
    <header class="page-head">
      <p class="meta">
        <time datetime={isoDate(d.pubDate)}>{formatDate(d.pubDate)}</time>
        {d.updatedDate && <span>更新 {formatDate(d.updatedDate)}</span>}
        <span>約{readingMinutes(post.body)}分で読めます</span>
        {d.draft && <span class="draft">下書き（本番には公開されません）</span>}
      </p>
      <h1 class="page-title">{d.title}</h1>
      {
        d.tags.length > 0 && (
          <ul class="tags">
            {d.tags.map((t) => <li><a class="tag" href={tagHref(t)}>{t}</a></li>)}
          </ul>
        )
      }
    </header>

    {d.cover && <Image class="cover" src={d.cover} alt={d.coverAlt ?? ''} widths={[700, 1400]} sizes="(max-width: 740px) 100vw, 700px" />}

    {
      toc.length >= 3 && (
        <nav class="toc" aria-label="目次">
          <p>目次</p>
          <ol>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <aside class="author">
      <p class="eyebrow">Written by</p>
      <p class="author-name">{AUTHOR.name}<span>{AUTHOR.role}</span></p>
      <p>取材・執筆のご依頼は <a href="/contact/">お問い合わせ</a> からどうぞ。</p>
    </aside>

    <nav class="pager" aria-label="前後の記事">
      <span>{newer && <a href={`/blog/${newer.id}/`}>← {newer.data.title}</a>}</span>
      <span>{older && <a href={`/blog/${older.id}/`}>{older.data.title} →</a>}</span>
    </nav>
  </article>
</BaseLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    font-size: 0.82rem;
    color: var(--ink-faint);
    margin: 0 0 1rem;
  }

  .draft {
    color: var(--accent);
  }

  .page-title {
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    line-height: 1.5;
  }

  .tags {
    margin-top: 1.4rem;
  }

  .cover {
    width: 100%;
    margin-bottom: 2.5rem;
  }

  .toc {
    border: 1px solid var(--line);
    padding: 1.2rem 1.5rem;
    margin-bottom: 2.5rem;
    font-size: 0.92rem;
  }

  .toc p {
    margin: 0 0 0.5rem;
    font-weight: 500;
  }

  .toc ol {
    margin: 0;
    padding-left: 1.3em;
  }

  .toc a {
    text-decoration: none;
  }

  .author {
    margin-top: 4rem;
    padding: 1.6rem;
    background: var(--accent-soft);
    font-size: 0.9rem;
  }

  .author p {
    margin: 0;
  }

  .author-name {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    margin: 0.2rem 0 0.6rem !important;
  }

  .author-name span {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin-left: 0.8em;
  }

  .author a {
    color: var(--accent);
  }

  .pager span {
    max-width: 48%;
  }

  .pager span:last-child {
    text-align: right;
  }
</style>
