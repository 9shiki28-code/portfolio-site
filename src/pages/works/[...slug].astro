---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorks, formatDate, isoDate } from '../../lib/content';

export async function getStaticPaths() {
  const works = await getWorks();
  // 本文があるものだけ詳細ページを作る
  return works
    .filter((w) => w.body && w.body.trim().length > 0)
    .map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const d = work.data;
---

<BaseLayout title={d.title} description={d.summary} image={d.cover?.src} type="article">
  <article class="container container--narrow">
    <header class="page-head">
      <p class="eyebrow">Works / {d.type}</p>
      <h1 class="page-title">{d.title}</h1>
      <dl class="facts">
        <div><dt>掲載</dt><dd>{d.media}</dd></div>
        <div><dt>時期</dt><dd><time datetime={isoDate(d.date)}>{formatDate(d.date)}</time></dd></div>
        <div><dt>種類</dt><dd>{d.type}</dd></div>
        {d.tags.length > 0 && <div><dt>分野</dt><dd>{d.tags.join('、')}</dd></div>}
      </dl>
    </header>

    {d.cover && <Image class="cover" src={d.cover} alt={d.coverAlt ?? ''} widths={[700, 1400]} sizes="(max-width: 740px) 100vw, 700px" />}

    <div class="prose">
      <Content />
    </div>

    {
      d.url && (
        <p class="external">
          <a href={d.url} target="_blank" rel="noopener">掲載記事を読む（{d.media}）↗</a>
        </p>
      )
    }

    <p class="back"><a class="more-link" href="/works/">← 実績一覧へ</a></p>
  </article>
</BaseLayout>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin: 2rem 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
  }

  dt {
    font-size: 0.72rem;
    color: var(--ink-faint);
    letter-spacing: 0.1em;
  }

  dd {
    margin: 0;
  }

  .cover {
    width: 100%;
    margin-bottom: 2.5rem;
  }

  .external {
    margin-top: 3rem;
    padding: 1.2rem 1.4rem;
    background: var(--accent-soft);
  }

  .external a {
    color: var(--accent);
  }

  .back {
    margin-top: 3rem;
  }
</style>
