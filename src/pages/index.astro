---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkGrid from '../components/WorkGrid.astro';
import PostList from '../components/PostList.astro';
import { Image } from 'astro:assets';
import { AUTHOR } from '../consts.js';
import { getPosts, getWorks } from '../lib/content';
import { resolveImage } from '../lib/images';
// 文章は src/data/home.json（Pages CMS の「トップページ」）で編集します
import home from '../data/home.json';
import about from '../data/about.json';

const portrait = resolveImage(about.portrait, '/src/assets/profile/portrait.jpg');

const works = await getWorks();
const featured = works.filter((w) => w.data.featured);
const pickup = (featured.length > 0 ? featured : works).slice(0, 3);
const posts = (await getPosts()).slice(0, 4);
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      {home.eyebrow && <p class="eyebrow">{home.eyebrow}</p>}
      <h1 class="hero-title">{home.heroTitle}</h1>
      {home.heroLead && <p class="hero-lead">{home.heroLead}</p>}
      <div class="hero-actions">
        <a class="btn" href="/works/">{home.primaryButton || '実績を見る'}</a>
        <a class="btn btn--ghost" href="/contact/">{home.secondaryButton || 'お仕事のご相談'}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Selected Works</p>
          <h2 class="section-title">主な実績</h2>
        </div>
        <a class="more-link" href="/works/">すべての実績 →</a>
      </div>
      <WorkGrid works={pickup} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Journal</p>
          <h2 class="section-title">最新のブログ</h2>
        </div>
        <a class="more-link" href="/blog/">記事一覧 →</a>
      </div>
      <PostList posts={posts} />
    </div>
  </section>

  <section class="section">
    <div class="container about-strip">
      <div class="who">
        {
          portrait && (
            <Image
              class="portrait"
              src={portrait}
              alt={`${AUTHOR.name}のプロフィール写真`}
              widths={[160, 320, 480]}
              sizes="160px"
            />
          )
        }
        <div>
          <p class="eyebrow">Profile</p>
          <h2 class="section-title">{AUTHOR.name}</h2>
          <p class="role">{AUTHOR.role}</p>
        </div>
      </div>
      <div>
        {home.profileText && <p>{home.profileText}</p>}
        <a class="more-link" href="/about/">プロフィールを詳しく →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(72px, 14vw, 168px) clamp(56px, 10vw, 120px);
    border-bottom: 1px solid var(--line);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.9rem, 5.2vw, 3.4rem);
    line-height: 1.5;
    letter-spacing: 0.06em;
    margin: 0.4rem 0 0;
    max-width: 16em;
  }

  .hero-lead {
    color: var(--ink-soft);
    max-width: 36em;
    margin: 1.8rem 0 0;
  }

  .hero-actions {
    display: flex;
    gap: 0.8rem;
    margin-top: 2.4rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.7rem 1.6rem;
    background: var(--ink);
    color: var(--bg);
    text-decoration: none;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    border: 1px solid var(--ink);
    transition: background 0.2s, color 0.2s;
  }

  .btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .btn--ghost {
    background: transparent;
    color: var(--ink);
  }

  .about-strip {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(1.5rem, 5vw, 4rem);
  }

  .about-strip p {
    margin: 0 0 1.2rem;
    color: var(--ink-soft);
  }

  .who {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .who .portrait {
    width: 160px;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 22%;
    border-radius: 50%;
  }

  .about-strip .role {
    font-size: 0.85rem;
    color: var(--ink-faint);
    margin-top: 0.4rem;
  }

  @media (max-width: 720px) {
    .about-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
