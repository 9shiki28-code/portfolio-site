---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR, CONTACT } from '../consts.js';
import pages from '../data/pages.json';

const hasForm = CONTACT.formAction.trim().length > 0;
const showEmail = !hasForm || CONTACT.showEmail;
// 紹介文は src/data/pages.json（Pages CMS の「ページの紹介文」）で編集します
const lead = hasForm ? pages.contact.lead : pages.contact.lead?.replace('下のフォーム', 'メール');
---

<BaseLayout title="お問い合わせ" description={pages.contact.description}>
  <div class="container container--narrow">
    <header class="page-head">
      <p class="eyebrow">Contact</p>
      <h1 class="page-title">お問い合わせ</h1>
      {lead && <p class="page-lead">{lead}</p>}
    </header>

    {
      hasForm && (
        <form class="form" action={CONTACT.formAction} method="POST" data-contact-form>
          <div class="field">
            <label for="name">お名前<span class="req">必須</span></label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="company">会社名・媒体名<span class="opt">任意</span></label>
            <input id="company" name="company" type="text" autocomplete="organization" />
          </div>
          <div class="field">
            <label for="email">メールアドレス<span class="req">必須</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="topic">ご用件</label>
            <select id="topic" name="topic">
              {CONTACT.topics.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="message">内容<span class="req">必須</span></label>
            <textarea id="message" name="message" rows="8" required></textarea>
          </div>

          {/* 迷惑メール対策（人には見えない欄。入力があると送信されません） */}
          <input type="text" name="_gotcha" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="_subject" value={`【サイトからのお問い合わせ】${AUTHOR.name}`} />

          <p class="note">
            送信内容は、フォームサービス（Formspree）を経由してメールで届きます。いただいた情報はお問い合わせへの返信にのみ使用します。
          </p>
          <button type="submit" class="submit">送信する</button>
          <p class="status" role="status" aria-live="polite" hidden></p>
        </form>
      )
    }

    {
      showEmail && (
        <div class="mail">
          <p class="label">{hasForm ? 'メールでのご連絡' : 'メール'}</p>
          <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
        </div>
      )
    }

    <section class="hint">
      <h2>ご依頼時にお知らせいただけると助かること</h2>
      <ul>
        <li>媒体・掲載先（雑誌、Webメディア、オウンドメディアなど）</li>
        <li>記事の内容と想定文字数、本数</li>
        <li>取材の有無と時期、場所</li>
        <li>納期とご予算</li>
      </ul>
    </section>

    {
      AUTHOR.links.length > 0 && (
        <ul class="sns">
          {AUTHOR.links.map((l) => <li><a href={l.href} target="_blank" rel="me noopener">{l.label}</a></li>)}
        </ul>
      )
    }
  </div>
</BaseLayout>

<script>
  // ページを移動せずに送信し、結果をその場に表示する（JSが無効でも通常の送信で動きます）
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLParagraphElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('.submit')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      button.textContent = '送信中…';
      status.hidden = true;
      status.classList.remove('is-error');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = '送信しました。お問い合わせありがとうございます。2営業日以内にご返信します。';
      } catch {
        status.textContent = '送信できませんでした。時間をおいて再度お試しください。';
        status.classList.add('is-error');
      } finally {
        status.hidden = false;
        button.disabled = false;
        button.textContent = '送信する';
      }
    });
  }
</script>

<style>
  .form {
    display: grid;
    gap: 1.4rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  label {
    font-size: 0.88rem;
    font-weight: 500;
  }

  .req,
  .opt {
    font-size: 0.68rem;
    font-weight: 400;
    margin-left: 0.6em;
    padding: 0.05em 0.5em;
    border-radius: 2px;
    vertical-align: 0.1em;
  }

  .req {
    background: var(--accent);
    color: #fff;
  }

  .opt {
    border: 1px solid var(--line);
    color: var(--ink-faint);
  }

  input,
  select,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem; /* iOSでの自動ズームを防ぐ */
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0.7rem 0.85rem;
    line-height: 1.6;
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .note {
    margin: 0;
    font-size: 0.78rem;
    color: var(--ink-faint);
    line-height: 1.7;
  }

  .submit {
    justify-self: start;
    font: inherit;
    font-size: 0.92rem;
    letter-spacing: 0.1em;
    padding: 0.8rem 2.6rem;
    background: var(--ink);
    color: var(--bg);
    border: 1px solid var(--ink);
    cursor: pointer;
    transition: background 0.2s;
  }

  .submit:hover:not(:disabled) {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .status {
    margin: 0;
    padding: 1rem 1.2rem;
    background: var(--accent-soft);
    font-size: 0.9rem;
  }

  .status.is-error {
    color: #b3261e;
  }

  .mail {
    margin-top: 2.5rem;
    padding: 2rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .form + .mail {
    margin-top: 3rem;
  }

  .label {
    margin: 0;
    font-size: 0.78rem;
    color: var(--ink-faint);
    letter-spacing: 0.1em;
  }

  .mail a {
    font-family: var(--font-en);
    font-size: clamp(1.3rem, 4vw, 1.8rem);
    letter-spacing: 0.03em;
    word-break: break-all;
  }

  .hint {
    margin-top: 3rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .hint h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
  }

  .sns {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    font-family: var(--font-en);
    font-size: 1.1rem;
  }
</style>
