---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR } from '../consts.js';
import { resolveImage } from '../lib/images';
// 文章は src/data/about.json（Pages CMS の「プロフィール」）で編集します
import about from '../data/about.json';

const portrait = resolveImage(about.portrait, '/src/assets/profile/portrait.jpg');
const intro = (about.intro ?? []).filter(Boolean);
const fields = (about.fields ?? []).filter((f) => f && f.title);
const career = (about.career ?? []).filter((c) => c && (c.year || c.text));
const qualifications = (about.qualifications ?? []).filter(Boolean);
---

<BaseLayout
  title="プロフィール"
  description={`${AUTHOR.role}・${AUTHOR.name}のプロフィールと対応分野。`}
  image={portrait?.src}
>
  <div class="container container--narrow">
    <header class="page-head profile-head">
      {
        portrait && (
          <Image
            class="portrait"
            src={portrait}
            alt={`${AUTHOR.name}のプロフィール写真`}
            widths={[240, 480, 720]}
            sizes="(max-width: 600px) 60vw, 240px"
            loading="eager"
          />
        )
      }
      <div>
        <p class="eyebrow">About</p>
        <h1 class="page-title">{AUTHOR.name}</h1>
        <p class="sub">
          {[AUTHOR.nameEn, AUTHOR.role, AUTHOR.location].filter(Boolean).join(' / ')}
        </p>
      </div>
    </header>

    <div class="prose">
      {intro.map((p) => <p>{p}</p>)}
    </div>

    {
      fields.length > 0 && (
        <section class="block">
          <h2 class="section-title">対応できる仕事</h2>
          <ul class="fields">
            {fields.map((f) => (
              <li>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      career.length > 0 && (
        <section class="block">
          <h2 class="section-title">経歴</h2>
          <ol class="career">
            {career.map((c) => (
              <li>
                <span class="year">{c.year}</span>
                <span>{c.text}</span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      qualifications.length > 0 && (
        <section class="block">
          <h2 class="section-title">資格・専門分野</h2>
          <ul class="plain">
            {qualifications.map((q) => <li>{q}</li>)}
          </ul>
        </section>
      )
    }

    <p class="cta">
      <a class="more-link" href="/contact/">お仕事のご相談はこちら →</a>
    </p>
  </div>
</BaseLayout>

<style>
  .profile-head {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: clamp(1.5rem, 5vw, 3rem);
    align-items: end;
  }

  .portrait {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 25%;
  }

  @media (max-width: 600px) {
    .profile-head {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .portrait {
      width: 60%;
      max-width: 260px;
    }
  }

  .sub {
    margin: 0.8rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  .block {
    margin-top: 4rem;
  }

  .block .section-title {
    font-size: 1.35rem;
    margin-bottom: 1.4rem;
  }

  .fields {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns:
      repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
  }

  .fields li {
    border: 1px solid var(--line);
    padding: 1.2rem 1.3rem;
    background: var(--surface);
  }

  .fields h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1rem;
    margin: 0 0 0.4rem;
  }

  .fields p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-soft);
    line-height: 1.8;
  }

  .career {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .career li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }

  .year {
    font-family: var(--font-en);
    font-size: 1.05rem;
    color: var(--accent);
  }

  .plain {
    padding-left: 1.2em;
    margin: 0;
  }

  .cta {
    margin-top: 4rem;
  }
</style>
